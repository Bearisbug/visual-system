{
  "$schema": "./tokens-schema.md",
  "$comment": "profile-2 full-depth example: every category declared, every fixed role mapped or given an explicit status. Fictional brand 'Sample'.",
  "meta": {
    "app": "Sample",
    "source": "visual-system",
    "spec": "DTCG-1.0 + design-extract/profile-2",
    "tiers": ["primitive", "semantic", "component"],
    "extensions": "com.design-extract",
    "modes": ["light", "dark"],
    "defaultMode": "light",
    "modeModel": "light-primary",
    "themes": [],
    "medium": "desktop",
    "platform": "web",
    "units": { "base": 4, "spaceUnit": 4, "sizeBasis": 1, "remBase": 16, "timeUnit": "ms", "reference": "1 unit = 1 CSS px at 1x" },
    "defaults": { "scope": "derived", "scaling": "absolute", "confidence": "derived" },
    "languages": ["zh-CN", "en"],
    "roles": {
      "text.primary": "semantic.color.text.primary",
      "text.secondary": "semantic.color.text.secondary",
      "text.tertiary": "semantic.color.text.tertiary",
      "surface.sunken": "semantic.color.surface.sunken",
      "surface.default": "semantic.color.surface.background",
      "surface.raised": "semantic.color.surface.raised",
      "surface.overlay": "semantic.color.surface.overlay",
      "accent": "semantic.color.action.primary",
      "onAccent": "semantic.color.text.onAction",
      "selection": "semantic.color.surface.selected",
      "divider": "semantic.color.border.subtle",
      "feedback.success": "semantic.color.feedback.success",
      "feedback.warning": "semantic.color.feedback.warning",
      "feedback.error": "semantic.color.feedback.error",
      "elevation.sunken": { "status": "notApplicable", "reason": "sunken surfaces are separated by fill only, no shadow" },
      "elevation.default": { "status": "notApplicable", "reason": "the base surface casts no shadow" },
      "elevation.raised": "semantic.elevation.raised",
      "elevation.overlay": "semantic.elevation.overlay",
      "state.hover": "semantic.state.hover.opacity",
      "state.focus": "semantic.state.focus.opacity",
      "state.pressed": "semantic.state.pressed.opacity",
      "state.dragged": "semantic.state.dragged.opacity",
      "state.disabled": "semantic.state.disabled.opacity",
      "focusRing.width": "semantic.state.focus.ringWidth",
      "focusRing.offset": "semantic.state.focus.ringOffset",
      "focusRing.color": "semantic.state.focus.ring",
      "space.withinGroup": "semantic.space.withinGroup",
      "space.betweenGroups": "semantic.space.betweenGroups",
      "space.section": "semantic.space.section",
      "radius.pill": "semantic.radius.pill",
      "radius.innerMin": "semantic.radius.innerMin",
      "hairline": "semantic.layout.hairline"
    },
    "categories": {
      "typography": { "status": "present" },
      "fontWeight": { "status": "present" },
      "color": { "status": "present" },
      "space": { "status": "present" },
      "radius": { "status": "present" },
      "elevation": { "status": "present" },
      "state": { "status": "present" },
      "motion": { "status": "present" },
      "hairline": { "status": "present" },
      "typographyDisplay": { "status": "present" },
      "breakpoint": { "status": "present" },
      "zIndex": { "status": "present" },
      "material": { "status": "notApplicable", "reason": "no translucent surfaces; every layer is opaque" },
      "dataViz": { "status": "present" }
    },
    "notUsed": [
      { "id": "gradient", "note": "no gradients on UI or marketing surfaces", "css": { "valuePattern": "gradient\\(" } },
      { "id": "text-shadow", "note": "no text shadow or glow", "css": { "property": "text-shadow" } },
      { "id": "backdrop-filter", "note": "no frosted glass; material is notApplicable", "css": { "property": "backdrop-filter" } },
      { "id": "nested-cards", "note": "cards never nest more than one level" }
    ]
  },
  "primitive": {
    "color": {
      "$type": "color",
      "neutral": {
        "0": { "$value": "#FFFFFF" },
        "50": { "$value": "#F7F7F8" },
        "100": { "$value": "#EFEFF1" },
        "200": { "$value": "#E2E2E6" },
        "300": { "$value": "#CBCBD1" },
        "400": { "$value": "#A1A1AA" },
        "600": { "$value": "#52525B" },
        "700": { "$value": "#3F3F46" },
        "800": { "$value": "#27272A" },
        "850": { "$value": "#1F1F23" },
        "900": { "$value": "#18181B" },
        "950": { "$value": "#0E0E10" }
      },
      "brand": {
        "accent": { "$value": "#3E5BD8" },
        "accentDark": { "$value": "#8FA2F4" },
        "tint": { "$value": "#E6EBFC" },
        "tintDark": { "$value": "#26305A" }
      },
      "feedback": {
        "success": { "$value": "#1E7A4C" },
        "successDark": { "$value": "#5CC993" },
        "warning": { "$value": "#9A5A06" },
        "warningDark": { "$value": "#F0B34A" },
        "error": { "$value": "#C1352B" },
        "errorDark": { "$value": "#F28B82" }
      },
      "dataViz": {
        "series": { "2": { "$value": "#992988" }, "3": { "$value": "#1195B4" }, "4": { "$value": "#EA3C93" }, "5": { "$value": "#8966F9" }, "6": { "$value": "#16558C" } },
        "sequential": { "1": { "$value": "#DAE4FF" }, "2": { "$value": "#A6BCF9" }, "3": { "$value": "#7593EE" }, "4": { "$value": "#4C6AD7" }, "5": { "$value": "#3148A4" } },
        "diverging": { "1": { "$value": "#9B5404" }, "2": { "$value": "#E0B391" }, "4": { "$value": "#ABBDEC" }, "5": { "$value": "#425EC9" } }
      },
      "dataVizDark": {
        "series": { "1": { "$value": "#4564F6" }, "2": { "$value": "#9F5D91" }, "3": { "$value": "#29A1C1" }, "4": { "$value": "#D82784" }, "5": { "$value": "#9477FC" }, "6": { "$value": "#3A75AF" } },
        "sequential": { "1": { "$value": "#2C3A67" }, "2": { "$value": "#4258A1" }, "3": { "$value": "#5E7AD3" }, "4": { "$value": "#85A1F0" }, "5": { "$value": "#B7C9F9" } },
        "diverging": { "1": { "$value": "#F0A466" }, "2": { "$value": "#875F3F" }, "4": { "$value": "#586792" }, "5": { "$value": "#9AB4FE" } }
      }
    },
    "dimension": {
      "$type": "dimension",
      "space": {
        "$extensions": { "com.design-extract": { "scaling": "scalable" } },
        "1": { "$value": 4 }, "2": { "$value": 8 }, "3": { "$value": 12 }, "4": { "$value": 16 },
        "5": { "$value": 20 }, "6": { "$value": 24 }, "8": { "$value": 32 }, "10": { "$value": 40 },
        "12": { "$value": 48 }, "16": { "$value": 64 }
      },
      "radius": { "xs": { "$value": 4 }, "sm": { "$value": 6 }, "md": { "$value": 10 }, "lg": { "$value": 16 }, "pill": { "$value": 999 } },
      "fontSize": {
        "$extensions": { "com.design-extract": { "scaling": "scalable" } },
        "12": { "$value": 12 }, "14": { "$value": 14 }, "16": { "$value": 16 }, "20": { "$value": 20 },
        "24": { "$value": 24 }, "30": { "$value": 30 }, "48": { "$value": 48 }, "72": { "$value": 72 }
      },
      "tracking": { "tightest": { "$value": -1.4 }, "tighter": { "$value": -0.6 }, "tight": { "$value": -0.2 }, "none": { "$value": 0 }, "wide": { "$value": 0.2 }, "wider": { "$value": 0.8 } },
      "hairline": { "$value": 0.5 },
      "ring": { "width": { "$value": 2 }, "offset": { "$value": 2 } },
      "breakpoint": { "sm": { "$value": 390 }, "lg": { "$value": 1440 } }
    },
    "fontFamily": {
      "$type": "fontFamily",
      "sans": { "$value": ["Space Grotesk", "Noto Sans SC", "system-ui", "sans-serif"] },
      "cjk": { "$value": ["Noto Sans SC", "Space Grotesk", "system-ui", "sans-serif"] },
      "mono": { "$value": ["JetBrains Mono", "ui-monospace", "monospace"] }
    },
    "fontWeight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 }, "medium": { "$value": 500 }, "semibold": { "$value": 600 }
    },
    "ratio": {
      "$type": "number",
      "$extensions": { "com.design-extract": { "scaling": "ratio" } },
      "lineHeight": { "display": { "$value": 1.05 }, "headline": { "$value": 1.15 }, "tight": { "$value": 1.25 }, "snug": { "$value": 1.35 }, "normal": { "$value": 1.5 }, "relaxed": { "$value": 1.75 } }
    },
    "duration": { "$type": "duration", "fast": { "$value": 120 }, "base": { "$value": 200 }, "slow": { "$value": 320 } },
    "easing": { "$type": "cubicBezier", "standard": { "$value": [0.2, 0, 0, 1] }, "emphasized": { "$value": [0.3, 0, 0, 1] } },
    "opacity": {
      "$type": "number",
      "$extensions": { "com.design-extract": { "scaling": "ratio", "scope": "invariant", "confidence": "inferred", "provenance": "convention: reference state-layer values listed in the component specimen spec §2; text contrast re-checked after compositing" } },
      "hover": { "$value": 0.08 }, "focus": { "$value": 0.1 }, "pressed": { "$value": 0.1 }, "dragged": { "$value": 0.16 }, "disabled": { "$value": 0.38 }
    }
  },
  "semantic": {
    "color": {
      "$type": "color",
      "text": {
        "primary": { "$value": "{primitive.color.neutral.900}" },
        "secondary": { "$value": "{primitive.color.neutral.700}" },
        "tertiary": { "$value": "{primitive.color.neutral.600}" },
        "onAction": { "$value": "{primitive.color.neutral.0}" }
      },
      "surface": {
        "sunken": { "$value": "{primitive.color.neutral.100}" },
        "background": { "$value": "{primitive.color.neutral.50}" },
        "raised": { "$value": "{primitive.color.neutral.0}" },
        "overlay": { "$value": "{primitive.color.neutral.0}" },
        "selected": { "$value": "{primitive.color.brand.tint}" }
      },
      "border": { "subtle": { "$value": "{primitive.color.neutral.200}" } },
      "action": { "primary": { "$value": "{primitive.color.brand.accent}" } },
      "feedback": {
        "success": { "$value": "{primitive.color.feedback.success}" },
        "warning": { "$value": "{primitive.color.feedback.warning}" },
        "error": { "$value": "{primitive.color.feedback.error}" }
      },
      "dataViz": {
        "$description": "Derived from the accent (OKLCH L 0.525 C 0.194 H 269; dark accentDark L 0.731). series: hues kept in OKLCH H 220 to 355, because warm and green hues (about H 10 to 215) come within dE 15 of the light feedback colors; slot order and per-mode L/C chosen so the set passes the series checks of tokens-schema 6.3 in both modes, including all three pairs among series.1 to 3, the series that scatter, bubble and small-multiple charts use. series.1 is the accent in light; accentDark sits above the dark lightness band (0.48 to 0.67), so dark series.1 keeps H 269 at L 0.57 C 0.22. Per slot (H; light L C; dark L C), OKLCH converted to sRGB hex: 1 (269; accent; 0.57 0.22), 2 (335; 0.49 0.18; 0.57 0.11), 3 (220; 0.62 0.11; 0.66 0.11), 4 (355; 0.64 0.22; 0.59 0.22), 5 (290; 0.62 0.21; 0.66 0.19), 6 (250; 0.44 0.11; 0.55 0.11). Result, light / dark: worst adjacent CVD dE 8.7 / 9.0, worst adjacent normal-vision dE 20.7 / 16.8; all pairs among series.1 to 3: CVD dE 12.3 / 9.0, normal-vision dE 17.5 / 19.1; all pairs over series.1 to 6: CVD dE 3.6 (2-6) / 4.6 (2-4), normal-vision dE 12.2 (1-5) / 12.2 (1-5); nearest feedback color dE 15.8 / 15.7, lowest contrast against the four surface roles 3.06 / 3.08. sequential: accent hue, low to high magnitude, L 0.92 to 0.44 in light and 0.36 to 0.84 in dark. diverging: accent+150 deg (orange) to the accent hue through a neutral midpoint (neutral.200 light, neutral.700 dark).",
        "$extensions": { "com.design-extract": { "confidence": "derived" } },
        "series": {
          "1": { "$value": "{primitive.color.brand.accent}" },
          "2": { "$value": "{primitive.color.dataViz.series.2}" },
          "3": { "$value": "{primitive.color.dataViz.series.3}" },
          "4": { "$value": "{primitive.color.dataViz.series.4}" },
          "5": { "$value": "{primitive.color.dataViz.series.5}" },
          "6": { "$value": "{primitive.color.dataViz.series.6}" }
        },
        "sequential": {
          "1": { "$value": "{primitive.color.dataViz.sequential.1}" },
          "2": { "$value": "{primitive.color.dataViz.sequential.2}" },
          "3": { "$value": "{primitive.color.dataViz.sequential.3}" },
          "4": { "$value": "{primitive.color.dataViz.sequential.4}" },
          "5": { "$value": "{primitive.color.dataViz.sequential.5}" }
        },
        "diverging": {
          "1": { "$value": "{primitive.color.dataViz.diverging.1}" },
          "2": { "$value": "{primitive.color.dataViz.diverging.2}" },
          "3": { "$value": "{primitive.color.neutral.200}" },
          "4": { "$value": "{primitive.color.dataViz.diverging.4}" },
          "5": { "$value": "{primitive.color.dataViz.diverging.5}" }
        }
      }
    },
    "space": {
      "$type": "dimension",
      "$extensions": { "com.design-extract": { "scaling": "scalable" } },
      "withinGroup": { "$value": "{primitive.dimension.space.2}" },
      "betweenGroups": { "$value": "{primitive.dimension.space.6}" },
      "section": { "$value": "{primitive.dimension.space.12}" }
    },
    "radius": {
      "$type": "dimension",
      "$extensions": { "com.design-extract": { "cornerStyle": "soft" } },
      "sm": { "$value": "{primitive.dimension.radius.sm}" },
      "md": { "$value": "{primitive.dimension.radius.md}" },
      "lg": { "$value": "{primitive.dimension.radius.lg}" },
      "pill": { "$value": "{primitive.dimension.radius.pill}" },
      "innerMin": { "$value": "{primitive.dimension.radius.xs}" }
    },
    "typography": {
      "$type": "typography",
      "$extensions": { "com.design-extract": { "scaling": "scalable", "langOverrides": { "zh": { "fontFamily": "{primitive.fontFamily.cjk}", "letterSpacing": "{primitive.dimension.tracking.none}" } } } },
      "caption": { "$value": { "fontFamily": "{primitive.fontFamily.sans}", "fontSize": "{primitive.dimension.fontSize.12}", "fontWeight": "{primitive.fontWeight.regular}", "lineHeight": "{primitive.ratio.lineHeight.snug}", "letterSpacing": "{primitive.dimension.tracking.wide}" } },
      "label": { "$value": { "fontFamily": "{primitive.fontFamily.sans}", "fontSize": "{primitive.dimension.fontSize.14}", "fontWeight": "{primitive.fontWeight.medium}", "lineHeight": "{primitive.ratio.lineHeight.snug}", "letterSpacing": "{primitive.dimension.tracking.none}" } },
      "body": {
        "$value": { "fontFamily": "{primitive.fontFamily.sans}", "fontSize": "{primitive.dimension.fontSize.16}", "fontWeight": "{primitive.fontWeight.regular}", "lineHeight": "{primitive.ratio.lineHeight.normal}", "letterSpacing": "{primitive.dimension.tracking.none}" },
        "$extensions": { "com.design-extract": { "langOverrides": { "zh": { "fontFamily": "{primitive.fontFamily.cjk}", "lineHeight": "{primitive.ratio.lineHeight.relaxed}", "letterSpacing": "{primitive.dimension.tracking.none}" } } } }
      },
      "bodyStrong": { "$value": { "fontFamily": "{primitive.fontFamily.sans}", "fontSize": "{primitive.dimension.fontSize.16}", "fontWeight": "{primitive.fontWeight.semibold}", "lineHeight": "{primitive.ratio.lineHeight.normal}", "letterSpacing": "{primitive.dimension.tracking.none}" } },
      "heading3": { "$value": { "fontFamily": "{primitive.fontFamily.sans}", "fontSize": "{primitive.dimension.fontSize.20}", "fontWeight": "{primitive.fontWeight.semibold}", "lineHeight": "{primitive.ratio.lineHeight.snug}", "letterSpacing": "{primitive.dimension.tracking.tight}" } },
      "heading2": { "$value": { "fontFamily": "{primitive.fontFamily.sans}", "fontSize": "{primitive.dimension.fontSize.24}", "fontWeight": "{primitive.fontWeight.semibold}", "lineHeight": "{primitive.ratio.lineHeight.tight}", "letterSpacing": "{primitive.dimension.tracking.tight}" } },
      "heading1": { "$value": { "fontFamily": "{primitive.fontFamily.sans}", "fontSize": "{primitive.dimension.fontSize.30}", "fontWeight": "{primitive.fontWeight.semibold}", "lineHeight": "{primitive.ratio.lineHeight.tight}", "letterSpacing": "{primitive.dimension.tracking.tighter}" } },
      "code": {
        "$value": { "fontFamily": "{primitive.fontFamily.mono}", "fontSize": "{primitive.dimension.fontSize.14}", "fontWeight": "{primitive.fontWeight.regular}", "lineHeight": "{primitive.ratio.lineHeight.normal}", "letterSpacing": "{primitive.dimension.tracking.none}" },
        "$extensions": { "com.design-extract": { "langOverrides": { "zh": { "lineHeight": "{primitive.ratio.lineHeight.relaxed}" } } } }
      }
    },
    "typographyDisplay": {
      "$type": "typography",
      "$extensions": { "com.design-extract": { "scaling": "absolute", "langOverrides": { "zh": { "fontFamily": "{primitive.fontFamily.cjk}", "letterSpacing": "{primitive.dimension.tracking.none}" } } } },
      "hero": { "$value": { "fontFamily": "{primitive.fontFamily.sans}", "fontSize": "{primitive.dimension.fontSize.72}", "fontWeight": "{primitive.fontWeight.semibold}", "lineHeight": "{primitive.ratio.lineHeight.display}", "letterSpacing": "{primitive.dimension.tracking.tightest}" } },
      "headline": { "$value": { "fontFamily": "{primitive.fontFamily.sans}", "fontSize": "{primitive.dimension.fontSize.48}", "fontWeight": "{primitive.fontWeight.semibold}", "lineHeight": "{primitive.ratio.lineHeight.headline}", "letterSpacing": "{primitive.dimension.tracking.tighter}" } },
      "subhead": { "$value": { "fontFamily": "{primitive.fontFamily.sans}", "fontSize": "{primitive.dimension.fontSize.24}", "fontWeight": "{primitive.fontWeight.regular}", "lineHeight": "{primitive.ratio.lineHeight.snug}", "letterSpacing": "{primitive.dimension.tracking.none}" } },
      "eyebrow": { "$value": { "fontFamily": "{primitive.fontFamily.sans}", "fontSize": "{primitive.dimension.fontSize.14}", "fontWeight": "{primitive.fontWeight.medium}", "lineHeight": "{primitive.ratio.lineHeight.snug}", "letterSpacing": "{primitive.dimension.tracking.wider}" } }
    },
    "elevation": {
      "$type": "shadow",
      "$extensions": { "com.design-extract": { "strategy": { "light": "shadow", "dark": "border+fill" } } },
      "raised": { "$value": { "color": "#18181B14", "offsetX": 0, "offsetY": 1, "blur": 3, "spread": 0 } },
      "overlay": { "$value": { "color": "#18181B29", "offsetX": 0, "offsetY": 12, "blur": 32, "spread": 0 } }
    },
    "state": {
      "$extensions": { "com.design-extract": { "scope": "inferred", "scaling": "ratio", "confidence": "inferred" } },
      "hover": { "opacity": { "$type": "number", "$value": "{primitive.opacity.hover}" } },
      "focus": {
        "opacity": { "$type": "number", "$value": "{primitive.opacity.focus}" },
        "ring": { "$type": "color", "$value": "{primitive.color.brand.accent}" },
        "ringWidth": { "$type": "dimension", "$value": "{primitive.dimension.ring.width}", "$extensions": { "com.design-extract": { "scaling": "absolute" } } },
        "ringOffset": { "$type": "dimension", "$value": "{primitive.dimension.ring.offset}", "$extensions": { "com.design-extract": { "scaling": "absolute" } } }
      },
      "pressed": { "opacity": { "$type": "number", "$value": "{primitive.opacity.pressed}" } },
      "dragged": { "opacity": { "$type": "number", "$value": "{primitive.opacity.dragged}" } },
      "disabled": { "opacity": { "$type": "number", "$value": "{primitive.opacity.disabled}" } }
    },
    "motion": {
      "$extensions": { "com.design-extract": { "scope": "inferred", "confidence": "inferred" } },
      "duration": { "$type": "duration", "fast": { "$value": "{primitive.duration.fast}" }, "base": { "$value": "{primitive.duration.base}" }, "slow": { "$value": "{primitive.duration.slow}" } },
      "easing": { "$type": "cubicBezier", "standard": { "$value": "{primitive.easing.standard}" }, "emphasized": { "$value": "{primitive.easing.emphasized}" } },
      "reducedMotion": { "$type": "number", "$value": 0, "$extensions": { "com.design-extract": { "scaling": "ratio" } } }
    },
    "layout": {
      "$extensions": { "com.design-extract": { "scope": "inferred", "confidence": "inferred" } },
      "breakpoint": { "$type": "dimension", "sm": { "$value": "{primitive.dimension.breakpoint.sm}" }, "lg": { "$value": "{primitive.dimension.breakpoint.lg}" } },
      "hairline": { "$type": "dimension", "$value": "{primitive.dimension.hairline}" },
      "zIndex": {
        "$type": "number",
        "$extensions": { "com.design-extract": { "scaling": "ratio" } },
        "base": { "$value": 0 }, "sticky": { "$value": 100 }, "dropdown": { "$value": 200 }, "overlay": { "$value": 1000 }, "modal": { "$value": 1100 }, "toast": { "$value": 1200 }
      }
    }
  },
  "component": {}
}
